# Local auth settings for `pnpm dev`.
AUTH_BASE_URL="http://localhost:5173"
BETTER_AUTH_SECRET="replace-with-a-random-32-byte-secret"

# GitHub is used for both Better Auth sign-in and public origin discovery/fork reads.
# Register this callback URL with your GitHub OAuth App:
# http://localhost:5173/api/auth/callback/github
GITHUB_CLIENT_ID="replace-with-github-oauth-app-client-id"
GITHUB_CLIENT_SECRET="replace-with-github-oauth-app-client-secret"

# Optional fallback login provider. Register this callback URL with your OIDC provider:
# http://localhost:5173/api/auth/oauth2/callback/oidc
OIDC_DISCOVERY_URL="https://id.hopsken.com/.well-known/openid-configuration"
OIDC_CLIENT_ID="replace-with-oidc-client-id"
