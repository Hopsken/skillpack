#!/usr/bin/env bash
set -euo pipefail

export PATH="$HOME/.local/bin:$PATH"

if [[ "$(node --version 2>/dev/null || true)" != v22.* ]]; then
	echo "Node.js 22 is unavailable; rerun .agents/setup" >&2
	exit 1
fi

if ! pnpm --version >/dev/null 2>&1; then
	echo "pnpm is unavailable; rerun .agents/setup" >&2
	exit 1
fi

echo "Orb tooling is ready; this repository has no persistent services to resume"
