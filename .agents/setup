#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
local_bin="$HOME/.local/bin"
node_install_root="$HOME/.local/share/node-v22"

mkdir -p "$local_bin" "$HOME/.local/share"
export PATH="$local_bin:$PATH"

install_node() {
	local filename
	local checksum
	local download_dir
	local extracted_dir

	filename="$(curl -fsSL https://nodejs.org/dist/latest-v22.x/SHASUMS256.txt \
		| awk '$2 ~ /^node-v22\.[0-9]+\.[0-9]+-linux-x64\.tar\.xz$/ { print $2; exit }')"
	if [[ -z "$filename" ]]; then
		echo "Could not resolve the latest Node.js 22 release" >&2
		exit 1
	fi

	checksum="$(curl -fsSL https://nodejs.org/dist/latest-v22.x/SHASUMS256.txt \
		| awk -v filename="$filename" '$2 == filename { print $1; exit }')"
	download_dir="$(mktemp -d)"
	trap 'rm -rf "$download_dir"' RETURN

	echo "Installing ${filename%%-linux-*}..."
	curl -fsSL "https://nodejs.org/dist/latest-v22.x/$filename" -o "$download_dir/$filename"
	printf '%s  %s\n' "$checksum" "$download_dir/$filename" | sha256sum --check --status
	tar -xJf "$download_dir/$filename" -C "$download_dir"
	extracted_dir="$download_dir/${filename%.tar.xz}"

	rm -rf "$node_install_root"
	mv "$extracted_dir" "$node_install_root"
	for executable in node npm npx corepack; do
		ln -sfn "$node_install_root/bin/$executable" "$local_bin/$executable"
	done
}

if [[ "$(node --version 2>/dev/null || true)" != v22.* ]]; then
	install_node
fi

echo "Using Node.js $(node --version) and pnpm 10.11.1"
corepack enable --install-directory "$local_bin"
corepack install --global pnpm@10.11.1

cd "$repo_root"
pnpm install --frozen-lockfile --prefer-offline

if [[ ! -f apps/skillpack/.dev.vars ]]; then
	cp -- apps/skillpack/.dev.vars.example apps/skillpack/.dev.vars
	echo "Created apps/skillpack/.dev.vars from the example"
fi

if grep -q '^BETTER_AUTH_SECRET="replace-with-' apps/skillpack/.dev.vars; then
	auth_secret="$(node -e 'process.stdout.write(require("node:crypto").randomBytes(32).toString("hex"))')"
	sed -i "s|^BETTER_AUTH_SECRET=.*|BETTER_AUTH_SECRET=\"$auth_secret\"|" apps/skillpack/.dev.vars
	echo "Generated the local Better Auth secret"
fi

if ! grep -q '^BETTER_AUTH_TRUSTED_ORIGINS=' apps/skillpack/.dev.vars; then
	printf '\nBETTER_AUTH_TRUSTED_ORIGINS="https://*.e2b.app,https://*.onamp.dev"\n' \
		>> apps/skillpack/.dev.vars
fi

if [[ ! -f apps/skillpack/.env.local ]]; then
	touch apps/skillpack/.env.local
fi

if ! grep -q '^SKILLPACK_DEV_ALLOWED_HOSTS=' apps/skillpack/.env.local; then
	printf 'SKILLPACK_DEV_ALLOWED_HOSTS=".e2b.app,.onamp.dev"\n' \
		>> apps/skillpack/.env.local
fi

chmod 600 apps/skillpack/.dev.vars apps/skillpack/.env.local

pnpm db:migrate:local
echo "Orb setup complete"
