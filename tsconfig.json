{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "@cloudflare/workers-types",
      "vite/client",
      "node"
    ],
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/client/*"
      ],
      "@schemas/*": [
        "./src/schemas/*"
      ],
      "@db/*": [
        "./src/db/*"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts",
    "drizzle.config.ts",
    "worker-configuration.d.ts"
  ],
  "references": []
}
