{
  "name": "skillpack-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "check": "ultracite check",
    "db:generate": "pnpm --filter @skillpack/app db:generate",
    "db:migrate:local": "pnpm --filter @skillpack/app db:migrate:local",
    "db:migrate:remote": "pnpm --filter @skillpack/app db:migrate:remote",
    "db:seed:local": "pnpm --filter @skillpack/app db:seed:local",
    "deploy": "pnpm --filter @skillpack/app deploy",
    "dev": "turbo dev --filter @skillpack/app",
    "env:pull": "pnpm --filter @skillpack/app env:pull",
    "fix": "ultracite fix",
    "prepare": "husky",
    "preview": "pnpm --filter @skillpack/app preview",
    "test": "turbo test",
    "test:watch": "turbo test:watch",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0",
    "turbo": "^2.6.1",
    "typescript": "^5.8.3",
    "ultracite": "7.7.0"
  },
  "packageManager": "pnpm@10.11.1"
}
